datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  email             String    @unique
  normalizedEmail   String    @unique
  phoneNumber       String?
  passwordHash      String
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  avatarUrl         String?
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  mfaEnabled        Boolean   @default(false)
  isSuperAdmin      Boolean   @default(false)
  onboardingStatus  OnboardingStatus @default(NOT_STARTED)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       OrganizationMembership[]
  adminActionLogs   AdminActionLog[]
  sessions          Session[]
  kycProfile        KycProfile?
  consents          ConsentRecord[]
  tokens            Token[]
  sentInvitations   Invitation[] @relation("InvitedBy")
  notifications     Notification[]
  notificationPrefs NotificationPreference?
}

enum OnboardingStatus {
  NOT_STARTED
  PROFILE_CREATED
  EMAIL_VERIFIED
  ORGANIZATION_CREATED
  ORGANIZATION_DETAILS_COMPLETED
  COMPLIANCE_PENDING
  COMPLIANCE_VERIFIED
  SUBSCRIPTION_PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
  DELETED
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  legalName          String?
  organizationType   OrgType
  country            String
  state              String?
  industry           String?
  website            String?
  businessEmail      String?
  businessPhone      String?
  registrationNumber String?
  status             OrgStatus @default(ACTIVE)
  ownerId            String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships        OrganizationMembership[]
  apiClients         ApiClient[]
  transactions       Transaction[]
  webhookEndpoints   WebhookEndpoint[]
  financialConnections FinancialConnection[]
  expectedPayments   ExpectedPayment[]
  alerts             Alert[]
  subscription       Subscription?
  kybProfile         KybProfile?
  invitations        Invitation[]
  notifications      Notification[]
  reconciliationJobs ReconciliationJob[]
}

enum OrgType {
  INDIVIDUAL
  BUSINESS
  FINTECH
  BANK
  HOSPITAL
  UNIVERSITY
  ENTERPRISE
  OTHER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model OrganizationMembership {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[] @relation("RolePermissions")
  memberships OrganizationMembership[]
  invitations Invitation[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "organization.read"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       Role[]   @relation("RolePermissions")
}

model ApiClient {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  environment    ApiEnvironment @default(SANDBOX)
  status         ClientStatus   @default(ACTIVE)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  keys           ApiKey[]
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum ApiEnvironment {
  SANDBOX
  PRODUCTION
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model ApiKey {
  id               String    @id @default(uuid())
  apiClientId      String
  publicIdentifier String    @unique // e.g. vrq_live_8f3d...
  secretHash       String
  environment      ApiEnvironment
  scopes           String[]  // Array of scopes e.g. ["resolve:read", "transactions:verify"]
  status           KeyStatus @default(ACTIVE)
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiClient        ApiClient @relation(fields: [apiClientId], references: [id])
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model FinancialConnection {
  id              String    @id @default(uuid())
  organizationId  String
  provider        String    // e.g., PLAID, MONO
  environment     ApiEnvironment
  status          ConnectionStatus @default(CREATED)
  syncCursor      String?
  lastSyncAt      DateTime?
  accessToken     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id])
  accounts        FinancialAccount[]
}

enum ConnectionStatus {
  CREATED
  AUTHORIZATION_PENDING
  AUTHORIZED
  SYNCING
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

model FinancialAccount {
  id              String    @id @default(uuid())
  connectionId    String
  externalId      String
  name            String
  currency        String
  balance         BigInt?
  type            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  connection      FinancialConnection @relation(fields: [connectionId], references: [id])
  transactions    Transaction[]
}

model Transaction {
  id                    String    @id @default(uuid())
  organizationId        String
  accountId             String?
  provider              String
  externalTransactionId String
  amount                BigInt
  currency              String
  direction             String
  status                String
  source                String    @default("PROVIDER_SYNC")
  reference             String?
  transactionType       String?
  metadata              Json?
  occurredAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id])
  account               FinancialAccount? @relation(fields: [accountId], references: [id])
  verifications         VerificationRecord[]

  @@unique([provider, externalTransactionId])
}

model VerificationRecord {
  id             String    @id @default(uuid())
  transactionId  String
  method         String
  provider       String
  status         String    // e.g. PENDING, VERIFIED, FAILED
  result         Json?
  reasonCategory String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transaction    Transaction @relation(fields: [transactionId], references: [id])
}

model WebhookEndpoint {
  id             String    @id @default(uuid())
  organizationId String
  url            String
  secret         String
  environment    ApiEnvironment
  status         String    @default("ACTIVE")
  events         String[]  // Subscribed events
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  deliveries     WebhookDelivery[]
}

model WebhookDelivery {
  id                String    @id @default(uuid())
  webhookEndpointId String
  eventId           String    // Unique identifier for idempotency
  attemptNumber     Int       @default(1)
  status            String    // PENDING, SUCCEEDED, FAILED, DEAD_LETTER
  httpStatus        Int?
  responseTime      Int?
  failureReason     String?
  attemptedAt       DateTime  @default(now())
  nextRetryAt       DateTime?

  endpoint          WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])
}

model AdminActionLog {
  id             String    @id @default(uuid())
  adminId        String
  action         String
  targetType     String    // e.g. "ORGANIZATION", "USER", "API_KEY"
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  admin          User      @relation(fields: [adminId], references: [id])
}

model ExpectedPayment {
  id                String    @id @default(uuid())
  organizationId    String
  expectedAmount    BigInt
  currency          String
  externalReference String?
  dueDate           DateTime?
  status            String    // PENDING | MATCHED | PARTIALLY_MATCHED | EXCEPTION
  createdAt         DateTime  @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id])
  matches           ReconciliationMatch[]
}

model ReconciliationMatch {
  id                String    @id @default(uuid())
  expectedPaymentId String
  transactionId     String
  matchedAmount     BigInt
  strategyUsed      String    // EXACT | REFERENCE | MANUAL
  createdAt         DateTime  @default(now())

  expectedPayment   ExpectedPayment @relation(fields: [expectedPaymentId], references: [id])
}

model Proof {
  id             String    @id @default(uuid())
  verificationId String    @unique
  status         String    // ACTIVE | REVOKED | EXPIRED
  token          String    @unique // Shareable token
  createdAt      DateTime  @default(now())
}

model Alert {
  id             String    @id @default(uuid())
  organizationId String
  type           String    // RISK_SIGNAL | ANOMALY | REVIEW_REQUIRED
  severity       String    // LOW | MEDIUM | HIGH | CRITICAL
  status         String    // OPEN | RESOLVED
  resourceType   String
  resourceId     String
  description    String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    // e.g., TransactionCreated
  payload     Json
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Session {
  id              String    @id @default(uuid())
  userId          String
  deviceId        String?
  refreshTokenHash String
  status          String    @default("ACTIVE") // ACTIVE, REVOKED
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  
  user            User      @relation(fields: [userId], references: [id])
}

model LoginAttempt {
  id              String    @id @default(uuid())
  email           String
  success         Boolean
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
}

model SecurityEvent {
  id              String    @id @default(uuid())
  organizationId  String?
  userId          String?
  eventType       String    // LOGIN_FAILED, MFA_ENABLED, SUSPICIOUS_ACTIVITY
  severity        String    // INFO, LOW, HIGH, CRITICAL
  createdAt       DateTime  @default(now())
}

model Plan {
  id              String         @id @default(uuid())
  name            String         // STARTER, BUSINESS, ENTERPRISE
  monthlyPrice    BigInt
  yearlyPrice     BigInt
  currency        String         @default("NGN")
  maxApiKeys      Int
  maxTransactions Int
  features        Json           // Entitlements JSON
  subscriptions   Subscription[]
}

model Subscription {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  planId          String
  status          String    // ACTIVE, PAST_DUE, CANCELED
  interval        String    // MONTHLY, YEARLY
  currentPeriodEnd DateTime
  createdAt       DateTime  @default(now())
  
  organization    Organization @relation(fields: [organizationId], references: [id])
  plan            Plan         @relation(fields: [planId], references: [id])
  payments        Payment[]
}

model Payment {
  id              String    @id @default(uuid())
  subscriptionId  String
  amount          BigInt
  currency        String
  status          String    // PENDING, SUCCEEDED, FAILED
  providerRef     String    @unique
  createdAt       DateTime  @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
}

model UsageRecord {
  id              String    @id @default(uuid())
  organizationId  String
  feature         String    // e.g. 'transaction_verification'
  quantity        Int       @default(1)
  idempotencyKey  String    @unique // e.g. verification_id
  createdAt       DateTime  @default(now())
}

model KybProfile {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  provider        String    // MOCK_KYB
  status          String    // PENDING, VERIFIED, REJECTED
  legalName       String
  registrationNo  String?
  country         String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
}

model KycProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  provider        String    // MOCK_KYC
  status          String    // PENDING, VERIFIED, REJECTED
  country         String
  verificationLevel String  // TIER_1, TIER_2
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
}

model ConsentRecord {
  id              String    @id @default(uuid())
  userId          String
  consentType     String    // TERMS, PRIVACY, FINANCIAL_ACCESS
  version         String
  status          String    @default("GRANTED") // GRANTED, WITHDRAWN
  grantedAt       DateTime  @default(now())
  withdrawnAt     DateTime?
  
  user            User      @relation(fields: [userId], references: [id])
}

model AnalyticsAggregate {
  id              String    @id @default(uuid())
  organizationId  String
  metric          String    // e.g. total_transactions, api_requests
  value           BigInt
  period          String    // e.g. DAILY, MONTHLY
  date            DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, metric, period, date])
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  type      String    // PASSWORD_RESET, EMAIL_VERIFICATION, PHONE_VERIFICATION
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  
  user      User      @relation(fields: [userId], references: [id])
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  roleId         String
  token          String    @unique
  status         String    @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt      DateTime
  invitedById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  invitedBy      User         @relation("InvitedBy", fields: [invitedById], references: [id])
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  title          String
  message        String
  type           String    // BILLING, SECURITY, SYSTEM, etc.
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model NotificationPreference {
  id             String    @id @default(uuid())
  userId         String    @unique
  emailEnabled   Boolean   @default(true)
  smsEnabled     Boolean   @default(false)
  inAppEnabled   Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id])
}

model ReconciliationJob {
  id             String    @id @default(uuid())
  organizationId String
  status         String    // PENDING, PROCESSING, COMPLETED, FAILED
  startedAt      DateTime?
  completedAt    DateTime?
  matchedCount   Int       @default(0)
  unmatchedCount Int       @default(0)
  exceptionCount Int       @default(0)
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  exceptions     ReconciliationException[]
}

model ReconciliationException {
  id                String    @id @default(uuid())
  jobId             String
  transactionId     String?
  expectedPaymentId String?
  reason            String
  status            String    // OPEN, RESOLVED
  createdAt         DateTime  @default(now())

  job               ReconciliationJob @relation(fields: [jobId], references: [id])
}
