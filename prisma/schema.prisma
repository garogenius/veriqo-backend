datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  email             String    @unique
  normalizedEmail   String    @unique
  phoneNumber       String?
  passwordHash      String
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  avatarUrl         String?
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  isSuperAdmin      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       OrganizationMembership[]
  adminActionLogs   AdminActionLog[]
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
  DELETED
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  legalName          String?
  organizationType   OrgType
  country            String
  industry           String?
  website            String?
  registrationNumber String?
  status             OrgStatus @default(ACTIVE)
  ownerId            String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships        OrganizationMembership[]
  apiClients         ApiClient[]
  transactions       Transaction[]
  webhookEndpoints   WebhookEndpoint[]
  financialConnections FinancialConnection[]
  expectedPayments   ExpectedPayment[]
  alerts             Alert[]
}

enum OrgType {
  INDIVIDUAL
  BUSINESS
  FINTECH
  BANK
  HOSPITAL
  UNIVERSITY
  ENTERPRISE
  OTHER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model OrganizationMembership {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[] @relation("RolePermissions")
  memberships OrganizationMembership[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "organization.read"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       Role[]   @relation("RolePermissions")
}

model ApiClient {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  environment    ApiEnvironment @default(SANDBOX)
  status         ClientStatus   @default(ACTIVE)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  keys           ApiKey[]
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum ApiEnvironment {
  SANDBOX
  PRODUCTION
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model ApiKey {
  id               String    @id @default(uuid())
  apiClientId      String
  publicIdentifier String    @unique // e.g. vrq_live_8f3d...
  secretHash       String
  environment      ApiEnvironment
  scopes           String[]  // Array of scopes e.g. ["resolve:read", "transactions:verify"]
  status           KeyStatus @default(ACTIVE)
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiClient        ApiClient @relation(fields: [apiClientId], references: [id])
}

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model FinancialConnection {
  id              String    @id @default(uuid())
  organizationId  String
  provider        String    // e.g., PLAID, MONO
  environment     ApiEnvironment
  status          ConnectionStatus @default(CREATED)
  syncCursor      String?
  lastSyncAt      DateTime?
  accessToken     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id])
  accounts        FinancialAccount[]
}

enum ConnectionStatus {
  CREATED
  AUTHORIZATION_PENDING
  AUTHORIZED
  SYNCING
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

model FinancialAccount {
  id              String    @id @default(uuid())
  connectionId    String
  externalId      String
  name            String
  currency        String
  balance         BigInt?
  type            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  connection      FinancialConnection @relation(fields: [connectionId], references: [id])
  transactions    Transaction[]
}

model Transaction {
  id                    String    @id @default(uuid())
  organizationId        String
  accountId             String?
  provider              String
  externalTransactionId String
  amount                BigInt
  currency              String
  direction             String
  status                String
  source                String    @default("PROVIDER_SYNC")
  reference             String?
  transactionType       String?
  metadata              Json?
  occurredAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id])
  account               FinancialAccount? @relation(fields: [accountId], references: [id])
  verifications         VerificationRecord[]

  @@unique([provider, externalTransactionId])
}

model VerificationRecord {
  id             String    @id @default(uuid())
  transactionId  String
  method         String
  provider       String
  status         String    // e.g. PENDING, VERIFIED, FAILED
  result         Json?
  reasonCategory String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transaction    Transaction @relation(fields: [transactionId], references: [id])
}

model WebhookEndpoint {
  id             String    @id @default(uuid())
  organizationId String
  url            String
  secret         String
  environment    ApiEnvironment
  status         String    @default("ACTIVE")
  events         String[]  // Subscribed events
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model AdminActionLog {
  id             String    @id @default(uuid())
  adminId        String
  action         String
  targetType     String    // e.g. "ORGANIZATION", "USER", "API_KEY"
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  admin          User      @relation(fields: [adminId], references: [id])
}

model ExpectedPayment {
  id                String    @id @default(uuid())
  organizationId    String
  expectedAmount    BigInt
  currency          String
  externalReference String?
  dueDate           DateTime?
  status            String    // PENDING | MATCHED | PARTIALLY_MATCHED | EXCEPTION
  createdAt         DateTime  @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id])
  matches           ReconciliationMatch[]
}

model ReconciliationMatch {
  id                String    @id @default(uuid())
  expectedPaymentId String
  transactionId     String
  matchedAmount     BigInt
  strategyUsed      String    // EXACT | REFERENCE | MANUAL
  createdAt         DateTime  @default(now())

  expectedPayment   ExpectedPayment @relation(fields: [expectedPaymentId], references: [id])
}

model Proof {
  id             String    @id @default(uuid())
  verificationId String    @unique
  status         String    // ACTIVE | REVOKED | EXPIRED
  token          String    @unique // Shareable token
  createdAt      DateTime  @default(now())
}

model Alert {
  id             String    @id @default(uuid())
  organizationId String
  type           String    // RISK_SIGNAL | ANOMALY | REVIEW_REQUIRED
  severity       String    // LOW | MEDIUM | HIGH | CRITICAL
  status         String    // OPEN | RESOLVED
  resourceType   String
  resourceId     String
  description    String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    // e.g., TransactionCreated
  payload     Json
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

